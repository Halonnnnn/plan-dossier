{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-dossier/plan.schema.json",
  "title": "L0 plan.yaml",
  "type": "object",
  "required": ["task_id", "version", "base", "objective", "acceptance", "dag", "excluded", "gaps"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "base": {
      "type": "object",
      "required": ["repo", "commit"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "commit": { "type": "string" },
        "env": { "type": "array", "items": { "type": "string" } }
      }
    },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "trust"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "why": { "type": "string" },
          "trust": { "enum": ["checked", "unverified"] },
          "assertion": {
            "type": "object",
            "required": ["replay", "expects"],
            "properties": {
              "replay": { "type": "string" },
              "expects": { "type": "string" }
            }
          },
          "by": { "$ref": "#/$defs/attribution" },
          "rederive_cost": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dag": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "task", "depends_on", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "task": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["pending", "in_progress", "done", "blocked", "needs_review"] }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "mitigated_by"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "mitigated_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "trust"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "why": { "type": "string" },
          "trust": { "enum": ["checked", "unverified"] },
          "by": { "$ref": "#/$defs/attribution" }
        }
      }
    },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator", "reason"],
        "properties": {
          "locator": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "attribution": {
      "type": "object",
      "required": ["model", "run", "at"],
      "properties": {
        "model": { "type": "string" },
        "run": { "type": "string" },
        "at": { "type": "string" }
      }
    }
  }
}
